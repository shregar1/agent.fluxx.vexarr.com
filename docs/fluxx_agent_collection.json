{
  "info": {
    "name": "Fluxx Edge Agent API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "High-performance REST & WebSocket API for architectural and Industrial (IoT/Factory) observability."
  },
  "item": [
    {
      "name": "Industrial Telemetry (IoT/Factory)",
      "item": [
        {
          "name": "List Recent Industrial Anomalies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/anomalies?protocol=Modbus",
              "host": ["{{base_url}}"],
              "path": ["v1", "anomalies"],
              "query": [
                {
                  "key": "protocol",
                  "value": "Modbus"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success: Actuator Latency Breach",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712218000000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"Industrial anomalies located.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:00:00+05:30\",\n  \"metadata\": { \"device_id\": \"plc-robot-1\" },\n  \"data\": [\n    {\n      \"protocol\": \"Modbus\",\n      \"level\": \"Critical\",\n      \"message\": \"Factory: PLC Actuator response breach (latency > 500ms).\"\n    }\n  ],\n  \"reference_urn\": \"\"\n}"
            }
          ]
        },
        {
          "name": "Get Sensor Trip Timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/sessions/sensor-trip-789",
              "host": ["{{base_url}}"],
              "path": ["v1", "sessions", "sensor-trip-789"]
            }
          },
          "response": [
            {
              "name": "Success: Trip Sequence",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712218100000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"IoT trip timeline retrieved.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:05:00+05:30\",\n  \"metadata\": { \"fleet\": \"EU-NORTH-1\" },\n  \"data\": {\n    \"id\": \"sensor-trip-789\",\n    \"history\": [\n      { \"event_id\": \"mqtt-1\", \"protocol\": \"Mqtt\", \"drift_factor\": 0.18 }\n    ]\n  },\n  \"reference_urn\": \"\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Standard Observability",
      "item": [
        {
          "name": "List All Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/sessions",
              "host": ["{{base_url}}"],
              "path": ["v1", "sessions"]
            }
          },
          "response": [
            {
              "name": "Success: Multiple Sessions",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712217600000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"Sessions list retrieved successfully.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:00:00+05:30\",\n  \"metadata\": {},\n  \"data\": [\n    {\n      \"id\": \"sess-123\",\n      \"start_time\": 1712217500,\n      \"service_id\": \"auth-service\"\n    }\n  ],\n  \"reference_urn\": \"\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "WebSocket Stream",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "ws://{{host}}:3000/v1/stream?service_id=plc-robot-1",
          "protocol": "ws",
          "host": ["{{host}}"],
          "port": "3000",
          "path": ["v1", "stream"],
          "query": [
            {
              "key": "service_id",
              "value": "plc-robot-1"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "host",
      "value": "localhost"
    }
  ]
}
