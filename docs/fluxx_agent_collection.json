{
  "info": {
    "name": "Fluxx Edge Agent API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "High-performance REST & WebSocket API for architectural observability and protocol telemetry."
  },
  "item": [
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List All Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/sessions",
              "host": ["{{base_url}}"],
              "path": ["v1", "sessions"]
            }
          },
          "response": [
            {
              "name": "Success: Multiple Sessions",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712217600000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"Sessions list retrieved successfully.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:00:00+05:30\",\n  \"metadata\": {},\n  \"data\": [\n    {\n      \"id\": \"sess-123\",\n      \"start_time\": 1712217500,\n      \"service_id\": \"auth-service\"\n    }\n  ],\n  \"reference_urn\": \"\"\n}"
            }
          ]
        },
        {
          "name": "Get Session Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/sessions/:id",
              "host": ["{{base_url}}"],
              "path": ["v1", "sessions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "sess-123"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success: Detail Found",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712217650000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"Session detail retrieved.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:05:00+05:30\",\n  \"metadata\": {},\n  \"data\": {\n    \"id\": \"sess-123\",\n    \"history\": [\n      { \"event_id\": \"ev-1\", \"protocol\": \"HTTP\", \"latency_us\": 1500 }\n    ]\n  },\n  \"reference_urn\": \"\"\n}"
            },
            {
              "name": "Error: Session Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712217700000\",\n  \"status\": \"FAILED\",\n  \"responseMessage\": \"Session not found.\",\n  \"responseKey\": \"NOT_FOUND\",\n  \"errors\": [\"The requested session might have been evicted.\"],\n  \"timestamp\": \"2026-04-03T12:10:00+05:30\",\n  \"metadata\": {},\n  \"data\": {},\n  \"reference_urn\": \"\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Anomalies",
      "item": [
        {
          "name": "List Recent Anomalies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/anomalies",
              "host": ["{{base_url}}"],
              "path": ["v1", "anomalies"]
            }
          },
          "response": [
            {
              "name": "Success: No Anomalies",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"transactionUrn\": \"urn:fluxx:tx:1712217800000\",\n  \"status\": \"SUCCESS\",\n  \"responseMessage\": \"Anomalies search results.\",\n  \"responseKey\": \"OK\",\n  \"errors\": [],\n  \"timestamp\": \"2026-04-03T12:15:00+05:30\",\n  \"metadata\": {},\n  \"data\": [],\n  \"reference_urn\": \"\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "WebSocket Stream",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "ws://{{host}}:3000/v1/stream?service_id=auth-service",
          "protocol": "ws",
          "host": ["{{host}}"],
          "port": "3000",
          "path": ["v1", "stream"],
          "query": [
            {
              "key": "service_id",
              "value": "auth-service"
            }
          ]
        },
        "description": "Real-time WebSocket event and insight broadcast with hierarchical filtering."
      },
      "response": [
        {
          "name": "Example Event Message",
          "body": "{\n  \"id\": \"ev-456\",\n  \"project_id\": \"fluxx-core\",\n  \"service_id\": \"auth-service\",\n  \"protocol\": \"Http\",\n  \"latency_us\": 2500,\n  \"timestamp_us\": 1712217900000\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "host",
      "value": "localhost"
    }
  ]
}
